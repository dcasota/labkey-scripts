# Copy to .env and fill in. .env is git-ignored and must never be committed.
# No variable below has a default. A script missing a required one aborts and
# names it. See the environment variable table in memory.md.

# --- LabKey publish target ---------------------------------------------------
LK_URL=https://127.0.0.1:8443
LK_USER=
LK_PASSWORD=
# Preferred over LK_USER/LK_PASSWORD. Mint with security-createApiKey.api and
# restrict it to EditorWithoutDelete for the publish bridge.
LK_APIKEY=
# Servlet context path; "auto" probes for "" then "/labkey".
LK_CONTEXT=auto
# 1 to skip TLS verification. Applied automatically for loopback hosts.
LK_INSECURE=

# --- Project memory (optional overrides) -------------------------------------
OSM_MEMORY_DB=
OSM_MEMORY_DUMP=

# --- Not yet supplied --------------------------------------------------------
# Code paths needing these fail with a clear message until they are set.
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL_ID=
GITHUB_TOKEN=
