__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Node / frontend -------------------------------------------------------
node_modules/
.next/
.vite/
*.tsbuildinfo

